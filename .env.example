# Razorpay dashboard → Settings → API Keys. Use rzp_test_* credentials only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay dashboard → Webhooks. Point the test webhook to /api/razorpay/webhook.
RAZORPAY_WEBHOOK_SECRET=

# Google AI Studio server-side key. Never expose it in browser code.
GEMINI_API_KEY=
